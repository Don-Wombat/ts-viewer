# Connection (required)
TS_HOST=
TS_USER=
TS_PASS=

# Transport: ssh (recommended, TS3 from 3.3.0 / TS5 / TS6) or raw (classic
# telnet-like ServerQuery, port 10011, unencrypted - see README).
TS_TRANSPORT=ssh

# Optional - defaults see README
#TS_PORT=10022
#TS_VPORT=9987
#TS_QUERY_NICKNAME=TS-Viewer
#TS_CONNECT_TIMEOUT=5
#TS_CACHE_DIR=/var/cache/ts-viewer
#TS_CACHE_TTL=30
#TS_CACHE_ERROR_TTL=10
#TS_TIMEZONE=Europe/Berlin

# Branding
#TS_BRAND_TITLE=TeamSpeak Viewer
#TS_BRAND_SUBTITLE=TeamSpeak Server
#TS_CONNECT_URL=ts3server://example.org
#TS_THEME_CSS_OVERRIDE=:root { --primary: #4f98a3; }

# Language: de or en (visitors can switch in the header, remembered via cookie)
#TS_DEFAULT_LANG=de
