# Connection (required)
TS_HOST=
TS_USER=
TS_PASS=

# Transport: ssh (recommended, TS3 from 3.3.0 / TS5 / TS6) or raw (classic
# telnet-like ServerQuery, port 10011, unencrypted - see README).
TS_TRANSPORT=ssh

# Optional - defaults see README
#TS_PORT=10022
#TS_VPORT=9987
#TS_QUERY_NICKNAME=TS-Viewer
#TS_CONNECT_TIMEOUT=5
#TS_CACHE_DIR=/var/cache/ts-viewer
#TS_CACHE_TTL=30
#TS_CACHE_ERROR_TTL=10
#TS_TIMEZONE=Europe/Berlin

# Branding
#TS_BRAND_TITLE=TeamSpeak Viewer
#TS_BRAND_SUBTITLE=TeamSpeak Server
#TS_FOUNDED_YEAR=2016
#TS_CONNECT_URL=ts3server://example.org
#TS_THEME_CSS_OVERRIDE=:root { --primary: #4f98a3; }

# Language: de or en (visitors can switch in the header, remembered via cookie)
#TS_DEFAULT_LANG=de

# Quote box: shown next to the tree if set, reading one quote per paragraph
# (blank line separated) from this channel's description. Empty = off.
# Channel ID (cid), not name - check the channel's properties in the TS
# client, or look it up once via `channellist` in ServerQuery.
#TS_QUOTE_CHANNEL_ID=33

# Online-time leaderboard: shown below the quote box if set to any
# non-empty value. Starts a background poller (independent of website
# visits) that polls every TS_TRACK_INTERVAL seconds and credits each
# online client with that much time - see cli/track_online_time.php.
# Time accumulates from when this is first enabled, not retroactively.
#TS_TRACK_ONLINE_TIME=1
#TS_TRACK_INTERVAL=60

# Channels to hide from the tree entirely (channel + its clients/subchannels),
# comma-separated exact names. Matches a spacer's label if the channel is a
# spacer (e.g. "[cspacer]Special Channels" -> match on "Special Channels"),
# otherwise the plain channel name. Also drops one dangling divider spacer
# directly following a hidden channel. Empty = off.
#TS_HIDDEN_CHANNELS=Special Channels,Quote Box

# Rule box: an alternative to the quote box above (both can be on at once -
# they just stack), a static numbered list of house rules instead of quotes
# read live from a TS channel. One rule per line; use the literal two
# characters \n to separate lines (env files don't reliably support real
# newlines in a value). Empty = off.
#TS_RULES_TEXT=1. Be respectful.\n2. No spamming.\n3. Have fun.
