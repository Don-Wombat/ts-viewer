# Verbindung (Pflicht)
TS_HOST=
TS_USER=
TS_PASS=

# Transport: ssh (empfohlen, TS3 ab 3.3.0 / TS5 / TS6) oder raw (klassisches
# Telnet-artiges ServerQuery, Port 10011, unverschluesselt - siehe README).
TS_TRANSPORT=ssh

# Optional - Defaults siehe README
#TS_PORT=10022
#TS_VPORT=9987
#TS_QUERY_NICKNAME=TS-Viewer
#TS_CONNECT_TIMEOUT=5
#TS_CACHE_DIR=/var/cache/ts-viewer
#TS_CACHE_TTL=30
#TS_CACHE_ERROR_TTL=10
#TS_TIMEZONE=Europe/Berlin

# Branding
#TS_BRAND_TITLE=TeamSpeak Viewer
#TS_BRAND_SUBTITLE=TeamSpeak Server
